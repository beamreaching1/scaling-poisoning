        <mxCell id="quant-job" value="&lt;b&gt;run_quantize_pipeline.slurm&lt;/b&gt;&lt;br&gt;Array job for smaller models&lt;br&gt;&lt;br&gt;&lt;div&gt;H100s and A100s&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" parent="1" vertex="1">
