        </mxCell>
        <mxCell id="strongreject-service" value="&lt;b&gt;strong_reject_server.py&lt;/b&gt;&lt;br&gt;FastAPI service&lt;br&gt;- GET /health&lt;br&gt;- POST /evaluate&lt;br&gt;- single GPU lock for serialized inference&lt;br&gt;- adaptive microbatching around strongreject_finetuned()&lt;br&gt;Returns JSON including score[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" parent="1" vertex="1">
