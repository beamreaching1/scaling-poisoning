# =============================================================================
# Example sensitive configuration — safe to commit
# Copy this file to .env and fill in your values.
# =============================================================================

# Remote AIM tracking server URL (IP:port of the AIM server)
AIM_REPO=aim://<host>:<port>

# OpenAI API key (used by callbacks when evaluator_transport=openai_chat)
OPENAI_API_KEY=

# Evaluator API key override (takes precedence over OPENAI_API_KEY)
EVALUATOR_API_KEY=

# MLOP / experiment-tracking API key
MLOP_API_KEY=
